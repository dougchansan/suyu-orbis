# Isolated LIBRARY build only. Never discovers the SDK's old libc++ headers.
set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_VERSION 12)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(OO_PS4_TOOLCHAIN "$ENV{OO_PS4_TOOLCHAIN}" CACHE PATH "Public OpenOrbis SDK")
if(NOT EXISTS "${OO_PS4_TOOLCHAIN}/include/stdio.h")
    message(FATAL_ERROR "Complete OpenOrbis SDK is required")
endif()
find_program(CMAKE_C_COMPILER NAMES clang-18 clang REQUIRED NO_CMAKE_FIND_ROOT_PATH)
find_program(CMAKE_CXX_COMPILER NAMES clang++-18 clang++ REQUIRED NO_CMAKE_FIND_ROOT_PATH)
find_program(CMAKE_AR NAMES llvm-ar-18 llvm-ar REQUIRED NO_CMAKE_FIND_ROOT_PATH)
find_program(CMAKE_RANLIB NAMES llvm-ranlib-18 llvm-ranlib REQUIRED NO_CMAKE_FIND_ROOT_PATH)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_ASM_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_SYSROOT "${OO_PS4_TOOLCHAIN}")
set(CMAKE_C_FLAGS_INIT "-fPIC -funwind-tables -march=btver2 -DPS4=1 -D_GNU_SOURCE=1 -isystem \"${OO_PS4_TOOLCHAIN}/include\"")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -nostdinc++")
set(CMAKE_ASM_FLAGS_INIT "--target=x86_64-pc-freebsd12-elf -fPIC -march=btver2 -DPS4=1 -isystem \"${OO_PS4_TOOLCHAIN}/include\"")
set(CMAKE_FIND_ROOT_PATH "${OO_PS4_TOOLCHAIN}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
